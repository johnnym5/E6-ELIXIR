rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Safely fetch user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: Check if requester is Admin
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email.matches('.*@basechaninternational\\.com$')) ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*\\.basechaninternational@gmail\\.com$')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserRole() in ['ADMIN', 'ADMIN_GOVERNANCE'])
      );
    }

    // Helper: Check if requester is Staff (Counselor or Auditor)
    function isStaff() {
       return request.auth != null && (
         isAdmin() ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserRole() in ['COUNSELOR', 'STAFF_AUDITOR'])
       );
    }

    // ── Users Collection ──
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      match /{allPaths=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin() || isStaff());
      }
    }

    // ── Financial Accounts ──
    match /financial_accounts/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin() ||
        isStaff()
      );
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isStaff()
      );
      allow update, delete: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin() ||
        isStaff()
      );

      match /transactions/{tId} {
        allow read, write: if request.auth != null && (
          (get(/databases/$(database)/documents/financial_accounts/$(docId)).data.userId == request.auth.uid) ||
          isAdmin() ||
          isStaff()
        );
      }
    }

    // ── PoF Evaluations ──
    match /pof_evaluations/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin() ||
        isStaff()
      );
      allow write: if request.auth != null && (
        (request.resource != null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin() ||
        isStaff()
      );
    }

    // ── Liquidity & Top-Up Requests ──
    match /liquidity_requests/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin() ||
        isStaff()
      );
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isStaff()
      );
      allow update, delete: if isAdmin() || isStaff();
    }

    match /topup_requests/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin() ||
        isStaff()
      );
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isStaff()
      );
      allow update, delete: if isAdmin() || isStaff();
    }

    // ── Notifications ──
    match /notifications/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin() ||
        isStaff()
      );
      allow create: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isStaff()
      );
      allow update, delete: if isAdmin() || isStaff();
    }

    // ── Audit Logs ──
    match /audit_logs/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.studentId == request.auth.uid) ||
        isAdmin() ||
        isStaff()
      );
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── Manual Adjustments ──
    match /manual_adjustments/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.studentId == request.auth.uid) ||
        isAdmin() ||
        isStaff()
      );
      allow write: if isAdmin() || isStaff();
    }

    // ── Support Tickets & Messages ──
    match /support_tickets/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin() ||
        isStaff()
      );
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || isStaff();
    }

    match /support_messages/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // ── System Configuration ──
    match /system_config/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Fallback ──
    match /{collectionId}/{docId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        isStaff() ||
        (resource != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.studentId == request.auth.uid ||
          resource.data.uid == request.auth.uid
        ))
      );
      allow write: if request.auth != null && (isAdmin() || isStaff());
    }
  }
}
