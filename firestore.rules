rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Fetch user data from the Firestore document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check if requester is Admin (By Email or Firestore Role)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.matches('.*@basechaninternational\\.com$') ||
        request.auth.token.email.matches('.*\\.basechaninternational@gmail\\.com$') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role in ['ADMIN', 'ADMIN_GOVERNANCE'])
      );
    }

    function isStaff() {
       return request.auth != null && (isAdmin() || getUserData().role in ['COUNSELOR', 'STAFF_AUDITOR']);
    }

    // ── Users Collection ──
    match /users/{userId} {
      allow read: if true;

      // Users can write their own profile, Admins can write any
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      match /{allPaths=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin() || isStaff());
      }
    }

    // ── Financial Accounts & Ledgers ──
    match /financial_accounts/{docId} {
      allow read, write: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin() || isStaff());
    }

    match /pof_evaluations/{docId} {
      allow read, write: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin() || isStaff());
    }

    match /topup_requests/{docId} {
      allow read, create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ── System Configuration ──
    match /system_config/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Fallback for all other collections ──
    match /{collectionId}/{docId} {
      allow read, write: if request.auth != null && (
        isAdmin() ||
        isStaff() ||
        (request.method == 'create') ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }
  }
}
