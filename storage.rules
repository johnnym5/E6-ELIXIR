rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Verify user is Admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.matches('.*@basechaninternational\\.com$') ||
        request.auth.token.email.matches('.*\\.basechaninternational@gmail\\.com$')
      );
    }

    // Allow authenticated users to manage their own folder
    match /student_documents/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /mandate_packages/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /student_packages/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // System assets (logo, templates) - Public Read
    match /system_assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global Fallback
    match /{allPaths=**} {
      allow read, write: if request.auth != null && isAdmin();
      // Allow users to see their own files if not in specific folders
      allow read: if request.auth != null;
    }
  }
}
